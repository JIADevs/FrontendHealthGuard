{
  "expo": {
    "name": "Helu",
    "slug": "helu",
    "owner": "juanr1001",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "extra": {
      "API_URL": "http://192.168.1.5:8000",
      "eas": {
        "projectId": "6e9a56d2-147d-4105-a519-5c46c15e179c"
      }
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "bundleIdentifier": "com.helu.app",
      "googleServicesFile": "./GoogleService-Info.plist",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Helu necesita la cámara para escanear tus documentos médicos.",
        "NSPhotoLibraryUsageDescription": "Helu necesita acceder a tus fotos para subir documentos desde la galería.",
        "NSMicrophoneUsageDescription": "Helu puede usar el micrófono al grabar video con la cámara.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true,
          "NSExceptionAllowsInsecureHTTPLoads": true,
          "NSExceptionDomains": {
            "localhost": {
              "NSTemporaryExceptionAllowsInsecureHTTPLoads": true
            },
            "192.168.0.0": {
              "NSTemporaryExceptionAllowsInsecureHTTPLoads": true
            },
            "192.168.1.0": {
              "NSTemporaryExceptionAllowsInsecureHTTPLoads": true
            }
          }
        }
      }
    },
    "android": {
      "package": "com.helu.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE"
      ],
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "usesCleartextTraffic": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Helu necesita la cámara para escanear tus documentos médicos.",
          "microphonePermission": "Helu puede usar el micrófono al grabar video con la cámara.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Helu necesita acceder a tus fotos para subir documentos desde la galería."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#0ea5e9",
          "defaultChannel": "default",
          "sounds": []
        }
      ]
    ]
  }
}
